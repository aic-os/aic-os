# Кошелёк для деплоя (создать командой: cast wallet import deployer --interactive)
# НИКОГДА не коммитить реальные ключи. Этот файл -- только документация.
DEPLOYER_ACCOUNT=deployer

# RPC-эндпоинты (публичные, ключ не нужен)
MAINNET_RPC=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
BASE_RPC=https://base-rpc.publicnode.com
ARBITRUM_RPC=https://arbitrum-one-rpc.publicnode.com

# API-ключ Etherscan для верификации (необязательно -- если пусто, --verify пропускается)
ETHERSCAN_API_KEY=
